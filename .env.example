# copy to .env and adjust as needed (docker compose sets its own values)
DATABASE_URL=postgresql+psycopg2://store:store@localhost:5432/store_intel
AUTOSEED=1
POS_WINDOW_S=300
METRICS_WINDOW_H=24
STALE_FEED_S=600
DEAD_ZONE_S=1800
QUEUE_SPIKE_DEPTH=5
# the POS sample is a different store than the footage; map it onto a real store
POS_STORE_MAP=ST1008:STORE_BLR_002
